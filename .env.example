# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789

# KIE.ai
KIE_API_KEY=your_kie_api_key_here

# YooKassa
YOOKASSA_TOKEN=your_yookassa_provider_token
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Database
# Хост postgre-ritual-retouch — имя DB-контейнера в docker-compose (dev и prod совпадают)
DATABASE_URL=postgresql://ritual_retouch:password@postgre-ritual-retouch:5432/ritual_retouch
POSTGRES_PASSWORD=password

# App settings
WEBAPP_URL=https://ritual-retouch.ru
TELEGRAM_BOT_USERNAME=RitualRetouch_bot
WEB_SERVER_PORT=8080

# Package settings (optional, defaults shown)
GENERATION_COST=1
DISCOUNTED_COST=1
DISCOUNTED_USER_IDS=
MIN_TOPUP=500
FREE_GENERATIONS=3

